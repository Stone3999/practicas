# OMNIRACK Backend - variables de entorno
# Copia este archivo a .env y ajusta los valores localmente.
# NUNCA subas .env al repositorio (esta en .gitignore).

PORT=3000

# Dias que se conservan las lecturas antes de ser eliminadas (LFPDPPP - retencion)
DATA_RETENTION_DAYS=30

# Limite maximo de lecturas por rack (ciclo de vida de datos)
MAX_READINGS_PER_RACK=5000
